# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Supabase (required) ---
# Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" / "publishable" key. This is bundled into client JS and is
# meant to be public — do not put the service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Experiential Labs (primary LLM gateway) ---
# https://platform.experientiallabs.ai — OpenAI-wire-protocol-compatible
# model gateway. Tried first for AI search + AI change suggestions. Get a
# key at https://platform.experientiallabs.ai/settings.
EXPLABS_API_KEY=
EXPLABS_MODEL=qwen3.8-27b

# --- OpenRouter (fallback LLM gateway) ---
# Only used if every Experiential Labs attempt above fails (or if
# EXPLABS_API_KEY is left unset, in which case this becomes primary).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m2.7:free

# --- Site URL (recommended once you have a real domain) ---
# Used to build the sitemap, robots.txt, and canonical/hreflang/OpenGraph
# tags with absolute URLs. If unset, falls back to Vercel's auto-provided
# deployment URL, then to http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=

# --- Shared secrets for internal-only routes (required) ---
# Pick any long random string for each (e.g. `openssl rand -hex 32`).
#   - CRON_SECRET: authorizes /api/cron/refresh (the scheduled AI
#     change-suggestion job — see vercel.json)
#   - ADMIN_SECRET: authorizes /api/admin/review (the manual approve/reject
#     UI at /[locale]/admin/review)
CRON_SECRET=
ADMIN_SECRET=

# --- Google Cloud Text-to-Speech (optional) ---
# Upgrades text-to-speech from the free built-in voice to Google Cloud's
# premium Chirp3-HD neural voice.
#
# You do NOT need this for natural-sounding speech — the site already uses
# a free Google voice (no signup, no billing) by default. This key only
# matters if you specifically want the higher-quality paid Chirp3-HD tier.
#
# Setup (only if you want the upgrade):
#   1. Create a Google Cloud project (or reuse one) at https://console.cloud.google.com/
#   2. Enable the "Cloud Text-to-Speech API" for that project.
#   3. Create an API key (APIs & Services > Credentials > Create Credentials
#      > API key), then restrict it to only the Cloud Text-to-Speech API.
#   4. Paste the key below.
#
# Note: Google requires a billing account linked to the project even to use
# the free monthly quota (1,000,000 characters/month of Chirp3-HD, renews
# monthly). A demo site like this one should stay comfortably within it and
# incur no charges. If you'd rather not set up billing at all, just leave
# this unset — the free engine already sounds noticeably better than a
# robotic default browser voice.
GOOGLE_TTS_API_KEY=

# Optional: Sarvam AI text-to-speech (https://docs.sarvam.ai) — a
# purpose-built Indian-language TTS model (Bulbul), tried before the other
# engines below since it's noticeably more natural for Hindi/Tamil/etc than
# either the paid Google Chirp3-HD voices or the free Google Translate
# fallback. Sign up at https://dashboard.sarvam.ai to get a key. Sarvam's
# free tier is credit-limited (not a recurring monthly quota like Google's),
# so once those credits run out every request fails over automatically to
# GOOGLE_TTS_API_KEY (if set) or the free engine — leave this unset entirely
# to skip Sarvam and go straight to the existing engine chain.
SARVAM_API_KEY=

# Optional: Voicebox (https://github.com/jamiepine/voicebox) — a free,
# open-source, self-hosted "AI voice studio" (FastAPI backend). Meant to
# become the SOLE narration voice for the whole site once configured —
# every other engine below (Sarvam/Google/free) only ever runs as a safety
# net if Voicebox itself is unreachable/misconfigured. This is NOT a hosted
# API — VOICEBOX_URL just points at wherever your own instance is running.
# To set it up:
#   1. git clone https://github.com/jamiepine/voicebox.git && cd voicebox
#   2. Either `docker compose up -d`, or run it directly with Python (see
#      the repo's README) — either way it listens on port 17493 by default.
#   3. Set VOICEBOX_URL below, then go to /[locale]/admin/voice on this
#      site (protected by ADMIN_SECRET below) and upload a short (10-30s)
#      voice sample there — it creates a Voicebox "profile" from that
#      sample automatically (transcription + upload handled for you) and
#      every /api/tts request immediately starts using it, no redeploy
#      needed. VOICEBOX_PROFILE_ID below is only a fallback for setting a
#      profile id directly via env var (e.g. one created by hand through
#      Voicebox's own API) if you'd rather not use the admin page.
# Leave VOICEBOX_URL unset to skip Voicebox entirely and go straight to
# Sarvam/Google/free. Any failure (instance unreachable, model still
# downloading, bad profile id) silently falls through to the rest of the
# chain — it never breaks TTS.
VOICEBOX_URL=
VOICEBOX_PROFILE_ID=

# --- Vaquill Indian legislation API (optional) ---
# https://app.vaquill.ai — a separate, paid/metered API (unrelated to
# Experiential Labs above) that indexes the actual text of ~64k Central/
# State/regulatory Indian enactments down to individual sections. Used to
# plug a gap in this site's own "By State" search: src/data/policies.ts
# only has a small hand-curated set of state-specific laws, so most states
# return zero state-specific results from the static dataset alone. When
# this key is set, AI search additionally does a live, sourced lookup
# against Vaquill's real legislation text for whichever state the user
# selected (see src/lib/vaquill.ts), and caches the result via
# src/lib/search-cache.ts so repeat queries don't re-spend credits.
# Leave unset to skip this entirely — state search still works off the
# static dataset alone, just with fewer states covered.
# Get a key at https://app.vaquill.ai/developer?tab=api-key. Pricing:
# https://api.vaquill.ai/api/v1/in/acts/pricing (~$0.02 per search call).
VAQUILL_API_KEY=
